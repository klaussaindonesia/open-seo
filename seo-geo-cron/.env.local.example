# Copy to .env.local (gitignored) and fill in real values.
# Sourced by run.sh / pilot-run.sh before invoking claude -p, so the job
# prompts can reference these as plain environment variables.

# klaussa_be production API
BACKEND_URL=https://api.klaussa.com

# WRITER-role bot account (src/api/v1/endpoints/blog.py: BLOG_ROLES_CAN_AUTHOR).
# Can create/author blog drafts. Structurally cannot approve/publish —
# verified live: calling /blogs/{id}/approve with this account returns 403.
WRITER_EMAIL=seo-geo-writer-bot@klaussa.com
WRITER_PASSWORD=

# blog-review-email worker (klaussa-lab/blog-review-email) — sends the
# human-in-the-loop approval email with Approve/Reject buttons.
BLOG_REVIEW_WORKER_URL=https://blog-review-email.navigoinfo-id.workers.dev
BLOG_REVIEW_HMAC_SECRET=
BLOG_REVIEW_RECIPIENT=zazaneryawan@gmail.com
